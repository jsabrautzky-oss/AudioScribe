<UserControl x:Class="AudioScribe.App.Views.SpeakerReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svc="clr-namespace:AudioScribe.App.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <svc:StringMatchToVisibilityConverter x:Key="MatchVis" />
        <svc:StringMatchToVisibilityConverter x:Key="MismatchVis" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="TitleLarge" Text="Sprecher identifizieren" Margin="0,4,0,2" />
        <ui:TextBlock Grid.Row="0" FontTypography="Caption" Opacity="0.75" Margin="0,0,0,10"
                      Text="Hören Sie kurz an und vergeben Sie Klarnamen — das Transkript übernimmt die Namen automatisch. Unbenannte Sprecher erhalten „Sprecher n“." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SpeakerItems" ItemsSource="{Binding Speakers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <ui:Button Width="44" Height="44" FontSize="22"
                                               IsEnabled="{Binding HasPreview}"
                                               Click="OnPlayClick" Tag="{Binding}"
                                               ToolTip="Hörprobe abspielen (4-7 s)">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="PlayCircle24" FontSize="20" />
                                        </ui:Button.Icon>
                                        <ui:Button.Visibility>
                                            <MultiBinding Converter="{StaticResource MismatchVis}">
                                                <Binding Path="DataContext.PlayingSpeakerId"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </ui:Button.Visibility>
                                    </ui:Button>
                                    <ui:Button Width="44" Height="44" FontSize="22"
                                               Click="OnStopClick" Tag="{Binding}"
                                               ToolTip="Wiedergabe pausieren">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="PauseCircle24" FontSize="20" />
                                        </ui:Button.Icon>
                                        <ui:Button.Visibility>
                                            <MultiBinding Converter="{StaticResource MatchVis}">
                                                <Binding Path="DataContext.PlayingSpeakerId"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </ui:Button.Visibility>
                                    </ui:Button>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding FallbackDisplayName}" />
                                    <ui:TextBlock FontTypography="Caption" Opacity="0.7" Text="{Binding Id}" />
                                    <TextBlock Text="{Binding PreviewSnippet}"
                                               Margin="0,4,0,0" MaxHeight="44" TextWrapping="Wrap"
                                               FontSize="12" FontStyle="Italic" Opacity="0.68"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasPreviewSnippet, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <ui:TextBox Grid.Column="2" VerticalAlignment="Center"
                                            PlaceholderText="z. B. Markus, Dr. Weber"
                                            Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <ui:TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0"
                                              FontTypography="Body" Text="{Binding DurationLabel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,4">
            <ui:Button Content="Zurück" Click="OnBackClick" Margin="0,0,10,0" />
            <ui:Button Appearance="Primary" Content="Namen anwenden &amp; Transkript anzeigen" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</UserControl>
