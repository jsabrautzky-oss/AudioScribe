<ui:FluentWindow x:Class="AudioScribe.App.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:vm="clr-namespace:AudioScribe.App.ViewModels"
                xmlns:views="clr-namespace:AudioScribe.App.Views"
                Title="AudioScribe – Lokale Transkription &amp; Sprechertrennung"
                Icon="pack://application:,,,/Assets/app_icon.ico"
                Width="1040" Height="720"
                MinWidth="860" MinHeight="560"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DropZoneViewModel}">
            <views:DropZoneView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
            <views:ProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpeakerReviewViewModel}">
            <views:SpeakerReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TranscriptResultViewModel}">
            <views:TranscriptResultView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="AudioScribe"
                     Icon="pack://application:,,,/Assets/app_icon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <ContentControl Grid.Row="1"
                        Margin="16,4,16,8"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentStep}" />

        <TextBlock Grid.Row="2"
                   Margin="16,0,16,10"
                   FontSize="12"
                   Opacity="0.7">
            <Run Text="{Binding StepTitle, Mode=OneWay}" />
            <Run Text=" — " />
            <Run Text="{Binding StatusBarText, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</ui:FluentWindow>
